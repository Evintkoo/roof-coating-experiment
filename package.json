{
  "name": "spandek",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "spandek": "bun run src/node/cli.ts",
    "check": "biome check . && tsc --noEmit && bun run test",
    "test": "bun test --parallel=3 --timeout 30000 --path-ignore-patterns '**/*.proof.test.ts'",
    "test:ci": "bun test --parallel=3 --timeout 30000 --path-ignore-patterns '**/*.proof.test.ts' --path-ignore-patterns 'tests/node/indonesia.test.ts' --path-ignore-patterns 'tests/indonesia.e2e.test.ts' --path-ignore-patterns 'tests/node/report/indonesia.test.ts' --path-ignore-patterns 'tests/node/epw.test.ts' --path-ignore-patterns 'tests/honesty.test.ts' --path-ignore-patterns 'tests/oracle.fixtures.test.ts' --path-ignore-patterns 'tests/refine.baseline.test.ts' --path-ignore-patterns 'tests/node/refine.test.ts' --path-ignore-patterns 'tests/core/models/thermal.test.ts' --path-ignore-patterns 'tests/web/pool.test.ts' --path-ignore-patterns 'tests/design.components.browser.test.ts' --path-ignore-patterns 'tests/web/anim/physicsPanel.test.ts' --path-ignore-patterns 'tests/report.design.browser.test.ts' --path-ignore-patterns 'tests/refine.e2e.test.ts' --path-ignore-patterns 'tests/pipeline.e2e.test.ts' --path-ignore-patterns 'tests/node/budget.test.ts' --path-ignore-patterns 'tests/budget.baseline.test.ts' --path-ignore-patterns 'tests/node/qa.test.ts'",
    "qa": "bun run src/node/qa.ts",
    "proof": "bun test --timeout 3600000 .proof.test.ts"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.3.14",
    "fast-check": "4.10.3",
    "playwright": "1.65.1",
    "plotly.js-dist-min": "4.3.0",
    "typescript": "7.0.2"
  }
}
